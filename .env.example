# Em dev (npm run dev) aponta direto para a API local.
# No Docker o nginx faz proxy de /api para o backend — aí basta "/api/v1".
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Na Vercel: a URL pública da API no Render (ver assethub-backend/DEPLOY.md).
# VITE_API_BASE_URL=https://SEU-APP.onrender.com/api/v1
